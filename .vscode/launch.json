{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SystemC: Stage1 (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/stage1_gcd.exe",
            "args": [
                "${workspaceFolder}/tests/stage1/basic.txt",
                "${workspaceFolder}/build/debug/stage1-output.txt",
                "${workspaceFolder}/build/debug/stage1-stats.csv",
                "2",
                "${workspaceFolder}/build/debug/stage1-events.csv"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/debug",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${config:scGcd.toolchainBin};${env:PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${config:scGcd.toolchainBin}/gdb.exe",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "SystemC: Build Debug"
        },
